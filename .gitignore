# ---------------------------------------------------------------------------
# SECRETS — never commit these. The signing keystore in particular is
# unrecoverable: lose it and the published app can never be updated again,
# and leaking it lets anyone sign an APK as this app.
# ---------------------------------------------------------------------------
*.jks
*.keystore
key.properties
**/service-account*.json
**/*-firebase-adminsdk-*.json
functions/.env
.env
.env.*
!.env.example

