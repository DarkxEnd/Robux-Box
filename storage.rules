rules_version = '2';

// Storage holds only two things: user avatars and support-ticket attachments.
// Both are size- and type-capped so a bucket can't be used as free hosting.
service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    function isImage() {
      return request.resource.contentType.matches('image/.*');
    }

    match /avatars/{uid}/{fileName} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == uid &&
        isImage() && request.resource.size < 5 * 1024 * 1024;
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    match /tickets/{uid}/{fileName} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow write: if signedIn() && request.auth.uid == uid &&
        isImage() && request.resource.size < 10 * 1024 * 1024;
      allow delete: if isAdmin();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
